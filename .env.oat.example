# Copy to .env for OAT / QA (oat-env branch deploy):
#   cp .env.oat.example .env

APP_PROFILE=oat
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Isolated OAT database (docker-compose.oat.yml)
POSTGRES_USER=pfa
POSTGRES_PASSWORD=change-me-oat-password
POSTGRES_DB=pfa_oat
API_PORT=3003

# Optional public URL if you expose OAT API
DOMAIN=oat-api.yourdomain.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_MINI_APP_URL=

LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# OAT: sign in with x-dev-telegram-id (see GET /api/v1/test/status)
DEV_AUTH_ENABLED=true
CORS_ORIGIN=http://localhost:5173,https://birrly.com

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=20

ADMIN_JWT_SECRET=change-me-oat-admin-jwt
ADMIN_JWT_EXPIRES_SEC=86400
ADMIN_BOOTSTRAP_EMAIL=admin@birrly.local
ADMIN_BOOTSTRAP_PASSWORD=changeme-admin

# First boot: system categories + demo users (@oat_amina, @oat_dawit)
RUN_DB_SEED=true
RUN_DEMO_SEED=true
ALLOW_DEMO_SEED=true

# Protects POST /api/v1/test/reset-demo
TEST_API_SECRET=change-me-oat-test-secret
