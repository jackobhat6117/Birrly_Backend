generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  EXPENSE
  INCOME

  @@map("transaction_type")
}

enum AccountType {
  CASH
  BANK
  TELEBIRR
  MPESA
  CARD
  OTHER

  @@map("account_type")
}

enum CategoryKind {
  EXPENSE
  INCOME
  BOTH

  @@map("category_kind")
}

enum TransactionSource {
  TELEGRAM
  MINI_APP
  API
  RECURRING
  SYSTEM

  @@map("transaction_source")
}

enum DebtType {
  OWED_TO_ME
  I_OWE

  @@map("debt_type")
}

enum DebtStatus {
  OPEN
  PARTIALLY_PAID
  SETTLED

  @@map("debt_status")
}

enum ReminderFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM

  @@map("reminder_frequency")
}

enum EqubFrequency {
  WEEKLY
  MONTHLY

  @@map("equb_frequency")
}

enum EqubStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("equb_status")
}

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED

  @@map("reminder_status")
}

enum SubscriptionPlan {
  FREE
  PREMIUM_MONTHLY
  PREMIUM_YEARLY

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

enum SubscriptionSource {
  SIGNUP_TRIAL
  TELEBIRR
  PROMO
  ADMIN

  @@map("subscription_source")
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("upgrade_request_status")
}

enum NotificationChannel {
  TELEGRAM

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_status")
}

model User {
  id               String   @id @default(uuid()) @map("id")
  telegramId       String   @unique @map("telegram_id")
  telegramUsername String?  @map("telegram_username")
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  language         String   @default("en") @map("language")
  currency         String   @default("ETB") @map("currency")
  timezone         String   @default("Africa/Addis_Ababa") @map("timezone")
  monthlyIncome    Decimal? @map("monthly_income") @db.Decimal(19, 4)
  monthlySpendPlan Decimal? @map("monthly_spend_plan") @db.Decimal(19, 4)
  paydayDay        Int?     @map("payday_day")
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  accounts               Account[]
  categories             Category[]
  transactions           Transaction[]
  debts                  Debt[]
  debtPayments           DebtPayment[]
  budgets                Budget[]
  savingsGoals           SavingsGoal[]
  reminders              Reminder[]
  recurringTransactions  RecurringTransaction[]
  subscription           Subscription?
  subscriptionUpgradeRequests SubscriptionUpgradeRequest[]
  payments               Payment[]
  notifications          Notification[]
  aiInteractions         AiInteraction[]
  monthlyInsights        MonthlyInsight[]
  equbs                  Equb[]
  auditLogs              AuditLog[]
  productEvents          ProductEvent[]
  feedback               Feedback[]

  @@map("users")
}

model Account {
  id         String      @id @default(uuid()) @map("id")
  userId     String      @map("user_id")
  name       String      @map("name")
  type       AccountType @map("type")
  currency   String      @default("ETB") @map("currency")
  isDefault  Boolean     @default(false) @map("is_default")
  isArchived Boolean     @default(false) @map("is_archived")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String       @id @default(uuid()) @map("id")
  userId    String?      @map("user_id")
  name      String       @map("name")
  slug      String       @map("slug")
  kind      CategoryKind @map("kind")
  isSystem  Boolean      @default(false) @map("is_system")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, slug])
  @@index([slug])
  @@index([isSystem])
  @@map("categories")
}

model Transaction {
  id              String            @id @default(uuid()) @map("id")
  userId          String            @map("user_id")
  accountId       String            @map("account_id")
  categoryId      String            @map("category_id")
  type            TransactionType   @map("type")
  amount          Decimal           @map("amount") @db.Decimal(19, 4)
  currency        String            @map("currency")
  description     String?           @map("description")
  transactionDate DateTime          @map("transaction_date") @db.Date
  source          TransactionSource @default(API) @map("source")
  idempotencyKey  String?           @map("idempotency_key")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@index([userId, deletedAt])
  @@map("transactions")
}

model Debt {
  id              String     @id @default(uuid()) @map("id")
  userId          String     @map("user_id")
  personName      String     @map("person_name")
  personTelegramUsername String? @map("person_telegram_username")
  type            DebtType   @map("type")
  originalAmount  Decimal    @map("original_amount") @db.Decimal(19, 4)
  remainingAmount Decimal    @map("remaining_amount") @db.Decimal(19, 4)
  currency        String     @map("currency")
  dueDate         DateTime?  @map("due_date") @db.Date
  note            String?    @map("note")
  status          DebtStatus @default(OPEN) @map("status")
  lastNudgedAt    DateTime?  @map("last_nudged_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId, status])
  @@index([userId, personName])
  @@map("debts")
}

model DebtPayment {
  id          String   @id @default(uuid()) @map("id")
  userId      String   @map("user_id")
  debtId      String   @map("debt_id")
  amount      Decimal  @map("amount") @db.Decimal(19, 4)
  currency    String   @map("currency")
  paidAt      DateTime @default(now()) @map("paid_at")
  note        String?  @map("note")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([userId, debtId])
  @@map("debt_payments")
}

model Budget {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  categoryId String  @map("category_id")
  amount    Decimal  @map("amount") @db.Decimal(19, 4)
  currency  String   @map("currency")
  period    String   @map("period")
  startDate DateTime @map("start_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, period])
  @@map("budgets")
}

model SavingsGoal {
  id            String   @id @default(uuid()) @map("id")
  userId        String   @map("user_id")
  name          String   @map("name")
  targetAmount  Decimal  @map("target_amount") @db.Decimal(19, 4)
  currentAmount Decimal  @default(0) @map("current_amount") @db.Decimal(19, 4)
  currency      String   @map("currency")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId])
  @@map("savings_goals")
}

model SavingsContribution {
  id            String   @id @default(uuid()) @map("id")
  savingsGoalId String   @map("savings_goal_id")
  amount        Decimal  @map("amount") @db.Decimal(19, 4)
  contributedAt DateTime @default(now()) @map("contributed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  savingsGoal SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  @@index([savingsGoalId])
  @@map("savings_contributions")
}

model Reminder {
  id          String            @id @default(uuid()) @map("id")
  userId      String            @map("user_id")
  title       String            @map("title")
  notes       String?           @map("notes")
  frequency   ReminderFrequency @default(ONCE) @map("frequency")
  nextRunAt   DateTime          @map("next_run_at")
  status      ReminderStatus    @default(ACTIVE) @map("status")
  debtId      String?           @map("debt_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("reminders")
}

model RecurringTransaction {
  id             String          @id @default(uuid()) @map("id")
  userId         String          @map("user_id")
  accountId      String          @map("account_id")
  categoryId     String          @map("category_id")
  type           TransactionType @map("type")
  amount         Decimal         @map("amount") @db.Decimal(19, 4)
  currency       String          @map("currency")
  description    String?         @map("description")
  frequency      ReminderFrequency @map("frequency")
  nextRunAt      DateTime        @map("next_run_at")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive, nextRunAt])
  @@index([userId])
  @@map("recurring_transactions")
}

model Subscription {
  id               String             @id @default(uuid()) @map("id")
  userId           String             @unique @map("user_id")
  plan             SubscriptionPlan   @default(FREE) @map("plan")
  status           SubscriptionStatus @default(ACTIVE) @map("status")
  source           SubscriptionSource? @map("source")
  currentPeriodEnd DateTime?          @map("current_period_end")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model SubscriptionUpgradeRequest {
  id            String               @id @default(uuid()) @map("id")
  userId        String               @map("user_id")
  referenceCode String               @unique @map("reference_code")
  plan          SubscriptionPlan     @map("plan")
  amount        Decimal              @map("amount") @db.Decimal(19, 4)
  currency      String               @default("ETB") @map("currency")
  status        UpgradeRequestStatus @default(PENDING) @map("status")
  adminNote     String?              @map("admin_note")
  reviewedAt    DateTime?            @map("reviewed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscription_upgrade_requests")
}

model PromoCode {
  id           String           @id @default(uuid()) @map("id")
  code         String           @unique @map("code")
  plan         SubscriptionPlan @map("plan")
  durationDays Int              @map("duration_days")
  maxUses      Int              @default(100) @map("max_uses")
  usedCount    Int              @default(0) @map("used_count")
  expiresAt    DateTime?        @map("expires_at")
  active       Boolean          @default(true) @map("active")
  note         String?          @map("note")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("promo_codes")
}

model Payment {
  id              String        @id @default(uuid()) @map("id")
  userId          String        @map("user_id")
  provider        String        @map("provider")
  providerPaymentId String?     @map("provider_payment_id")
  amount          Decimal       @map("amount") @db.Decimal(19, 4)
  currency        String        @map("currency")
  status          PaymentStatus @map("status")
  idempotencyKey  String?       @unique @map("idempotency_key")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model Notification {
  id         String              @id @default(uuid()) @map("id")
  userId     String              @map("user_id")
  channel    NotificationChannel @default(TELEGRAM) @map("channel")
  title      String              @map("title")
  body       String              @map("body")
  status     NotificationStatus  @default(PENDING) @map("status")
  sentAt     DateTime?           @map("sent_at")
  error      String?             @map("error")
  reminderId String?             @map("reminder_id")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}

model AiInteraction {
  id         String   @id @default(uuid()) @map("id")
  userId     String   @map("user_id")
  intent     String?  @map("intent")
  success    Boolean  @map("success")
  provider   String   @map("provider")
  latencyMs  Int?     @map("latency_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_interactions")
}

/// Premium "Insights" on Reports — LLM-phrased narration of numbers the
/// backend already computed, generated once per user per month and reused
/// until the user taps Refresh. Never a source of truth for money: `insights`
/// is a validated, size-capped JSON array of {message, tone}, not free text.
model MonthlyInsight {
  id          String   @id @default(uuid()) @map("id")
  userId      String   @map("user_id")
  year        Int      @map("year")
  month       Int      @map("month")
  insights    Json     @map("insights")
  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("monthly_insights")
}

/// A rotating savings group (Equb / እቁብ). The organizer owns the record; members
/// are tracked by name and optionally linked to a Telegram account when they
/// join via the share link. Birrly never moves money — this observes who has
/// contributed each cycle and whose turn it is to receive the pot.
model Equb {
  id                 String        @id @default(uuid()) @map("id")
  userId             String        @map("user_id")
  name               String        @map("name")
  contributionAmount Decimal       @map("contribution_amount") @db.Decimal(19, 4)
  currency           String        @map("currency")
  frequency          EqubFrequency @map("frequency")
  startDate          DateTime      @map("start_date") @db.Date
  status             EqubStatus    @default(ACTIVE) @map("status")
  currentCycle       Int           @default(1) @map("current_cycle")
  /// Opaque token for the t.me/<bot>?start=equb-<token> deep link.
  joinToken          String        @unique @map("join_token")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  members       EqubMember[]
  contributions EqubContribution[]

  @@index([userId, status])
  @@map("equbs")
}

model EqubMember {
  id               String   @id @default(uuid()) @map("id")
  equbId           String   @map("equb_id")
  name             String   @map("name")
  /// Set when the member joins via the share link — enables direct bot nudges.
  telegramUserId   String?  @map("telegram_user_id")
  telegramUsername String?  @map("telegram_username")
  /// 1-based rotation slot: the member whose position equals the Equb's
  /// currentCycle is the one due to receive the pot this cycle.
  payoutPosition   Int      @map("payout_position")
  payoutReceived   Boolean  @default(false) @map("payout_received")
  joinedAt         DateTime? @map("joined_at")
  createdAt        DateTime @default(now()) @map("created_at")

  equb          Equb               @relation(fields: [equbId], references: [id], onDelete: Cascade)
  contributions EqubContribution[]

  @@index([equbId])
  @@index([telegramUserId])
  @@map("equb_members")
}

model EqubContribution {
  id        String   @id @default(uuid()) @map("id")
  equbId    String   @map("equb_id")
  memberId  String   @map("member_id")
  cycle     Int      @map("cycle")
  amount    Decimal  @map("amount") @db.Decimal(19, 4)
  currency  String   @map("currency")
  paidAt    DateTime @default(now()) @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")

  equb   Equb       @relation(fields: [equbId], references: [id], onDelete: Cascade)
  member EqubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, cycle])
  @@index([equbId, cycle])
  @@map("equb_contributions")
}

model AuditLog {
  id         String   @id @default(uuid()) @map("id")
  userId     String?  @map("user_id")
  action     String   @map("action")
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?    @map("metadata")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model TelegramProcessedUpdate {
  updateId    BigInt   @id @map("update_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("telegram_processed_updates")
}

model AdminUser {
  id           String   @id @default(uuid()) @map("id")
  email        String   @unique @map("email")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

enum ProductEventName {
  SCREEN_VIEW
  TOUR_STARTED
  TOUR_COMPLETED
  TOUR_SKIPPED
  FEATURE_USED

  @@map("product_event_name")
}

enum FeedbackCategory {
  BUG
  IDEA
  OTHER

  @@map("feedback_category")
}

enum FeedbackSource {
  APP
  BOT

  @@map("feedback_source")
}

model ProductEvent {
  id        String           @id @default(uuid()) @map("id")
  userId    String           @map("user_id")
  name      ProductEventName @map("name")
  screen    String?          @map("screen")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([name, createdAt])
  @@index([screen, createdAt])
  @@map("product_events")
}

model Feedback {
  id          String           @id @default(uuid()) @map("id")
  userId      String           @map("user_id")
  category    FeedbackCategory @default(OTHER) @map("category")
  message     String           @map("message")
  source      FeedbackSource   @map("source")
  pageContext String?          @map("page_context")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("feedback")
}
