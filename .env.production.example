# Copy to .env on your VPS: cp .env.production.example .env

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Postgres (used by docker-compose.prod.yml — do not point at localhost)
POSTGRES_USER=pfa
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pfa

# Optional: expose API on host port when not using Caddy ssl profile
API_PORT=3000

# Public HTTPS domain (required for --profile ssl and Telegram webhooks)
DOMAIN=api.yourdomain.com

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
TELEGRAM_WEBHOOK_URL=https://api.yourdomain.com/webhooks/telegram

# LLM (optional — fallback parser works when disabled)
LLM_API_KEY=
LLM_PROVIDER=disabled
LLM_MODEL=

DEV_AUTH_ENABLED=false
CORS_ORIGIN=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=20

# Admin dashboard (required in production — generate a long random secret)
ADMIN_JWT_SECRET=generate-a-long-random-secret
ADMIN_JWT_EXPIRES_SEC=86400
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-admin-password

# Set true only on first deploy to seed system categories, then remove or set false
RUN_DB_SEED=false

# Never enable on main / production. Demo people exist only on oat-env.
ALLOW_DEMO_SEED=false
