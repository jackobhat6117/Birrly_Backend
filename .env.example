NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://pfa:pfa@localhost:5432/pfa?schema=public
REDIS_URL=redis://localhost:6379

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

LLM_API_KEY=
LLM_PROVIDER=disabled
LLM_MODEL=

# Local API testing only. Ignored when NODE_ENV=production.
DEV_AUTH_ENABLED=false

# Optional: CORS origins, comma-separated. Empty allows all in development.
# Production must list the Mini App origin, e.g. https://birrly.com,https://app.birrly.com
CORS_ORIGIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=20

# Internal admin dashboard. Bootstrap creates/updates the first operator.
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me
ADMIN_JWT_EXPIRES_SEC=86400
ADMIN_BOOTSTRAP_EMAIL=admin@birrly.local
ADMIN_BOOTSTRAP_PASSWORD=changeme-admin
